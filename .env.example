
#============================================================
# APPLICATION SETTINGS
#============================================================

# Application Port
SERVER_PORT=8080

# Active Spring profile (dev, prod, etc.)
SPRING_PROFILES_ACTIVE=dev
#============================================================

# MAIN DATABASE (H2)
# URL H2 database with transactions
H2_DATABASE_URL=jdbc:h2:file:./src/main/resources/transaction;DB_CLOSE_ON_EXIT=FALSE

#============================================================

# SECOND DATABASE (PostgreSQL)
# PostgreSQL connection settings
POSTGRES_URL=jdbc:postgresql://localhost:5432/dynamic_rules
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# TELEGRAM BOT SETTINGS
# Telegram Bot configuration
TELEGRAM_BOT_USERNAME=your_bot_username_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Logging Level
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
WEB_LOG_LEVEL=WARN
SQL_LOG_LEVEL=DEBUG

# Cache Configuration
CACHE_SIZE_MAX=1000
CACHE_TTL_HOURS=24

